RELAYER_PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=super-secret-dev-key
JWT_EXPIRES_IN=24h

# Relayer / Solana
ANCHOR_PROVIDER_URL=http://127.0.0.1:8899
SOLANA_RPC_URL=http://127.0.0.1:8899
RELAYER_PRIVATE_KEY=[1,2,3,...] # JSON array (ed25519 secret key)
PROGRAM_ID=AWVNBHaF1upXopq9dQpRpY54c9113bBskqiv16MUTDDd
IDL_PATH=./src/idl/cipherpay_anchor.json
CP_TREE_DEPTH=16
RELAYER_SKIP_ANCHOR=0

# CORS
CORS_ORIGIN=*

# Optional rate limits (see API.md)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=cipherpay_relayer_solana

SUCCESS_RATE_THRESHOLD=85
MIN_TX_SAMPLES=20
ERROR_RATE_THRESHOLD=5
SLOW_RESPONSE_THRESHOLD_MS=3000
HIGH_HEAP_USED_MB=800
ALERT_COOLDOWN_MS=60000
MONITOR_INTERVAL_MS=30000

# Auth options
DASHBOARD_AUTH=true
DASHBOARD_TOKEN=supersecret
API_TOKEN=supersecret
DISABLE_API_AUTH=1
DISABLE_DASHBOARD_AUTH=1
AUTH_JWT_ISSUER=https://example.com
AUTH_JWT_AUDIENCE=cipherpay-relayer

TEST_MINT=So11111111111111111111111111111111111111112

# --- Logging ---
LOG_LEVEL=info
MERKLE_TRACE=1
RELAYER_EVENT_DEBUG=1
SHOW_DB=0

RELAYER_AUTO_LISTEN=1

# OR single URL (overrides host/port/user/pass/db if set)
# MYSQL_URL=mysql://cipherpay:changeme@127.0.0.1:3306/cipherpay
