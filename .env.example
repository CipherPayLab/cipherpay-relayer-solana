# HTTP
RELAYER_PORT=4000

# Solana (local validator)
#SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_RPC_URL=https://api.devnet.solana.com

# Auto-airdrop: only enabled for localhost/127.0.0.1 RPC by default.
# On devnet/testnet, fund ANCHOR_WALLET manually (https://faucet.solana.com), or set:
#RELAYER_ALLOW_AUTO_AIRDROP=1
PROGRAM_ID=AWVNBHaF1upXopq9dQpRpY54c9113bBskqiv16MUTDDd
IDL_PATH=./src/idl/cipherpay_anchor.json

# Merkle tree (used by init-tree script)
CP_TREE_DEPTH=16

# MySQL (relayer DB — use port 3307 for second container; user/password must match what you set in Docker)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=cipherpay
MYSQL_PASSWORD=cipherpay
MYSQL_DB=cipherpay_relayer_solana

# API token (match RELAYER_TOKEN on app server)
API_TOKEN=supersecret

